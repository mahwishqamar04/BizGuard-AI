# =============================================================
# BizGuard AI - Backend Environment Variables
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================

# Server
PORT=5000

# -----------------------------------------------------------
# CORS — Production Frontend Origins
# -----------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# Leave empty for local development (localhost is always allowed).
# Example: CORS_ORIGINS=https://bizguard.example.com
# -----------------------------------------------------------
# CORS_ORIGINS=

# -----------------------------------------------------------
# AI - Alibaba Cloud / Qwen API Key (optional)
# If not set, the backend uses a mock implementation that
# provides realistic business insights and recommendations.
# -----------------------------------------------------------
# QWEN_API_KEY=your_qwen_api_key_here
# ALIBABA_API_KEY=your_alibaba_api_key_here

# -----------------------------------------------------------
# MySQL Database (local or Alibaba Cloud RDS)
# -----------------------------------------------------------
# If not configured, the backend falls back to in-memory
# storage and the MVP still works normally.
#
# LOCAL DEVELOPMENT:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=bizguard_ai
# DB_SSL=false
#
# ALIBABA CLOUD RDS:
# DB_HOST=rm-xxxxxxxxxxxxx.mysql.rds.aliyuncs.com
# DB_PORT=3306
# DB_USER=bizguard_user
# DB_PASSWORD=your_rds_password_here
# DB_NAME=bizguard_ai
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# -----------------------------------------------------------

DB_HOST=localhost
DB_PORT=3306
DB_USER=bizguard_user
DB_PASSWORD=your_password_here
DB_NAME=bizguard_ai
DB_SSL=false
