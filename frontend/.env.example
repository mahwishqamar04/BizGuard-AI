# =============================================================
# BizGuard AI — Frontend Environment Variables
# =============================================================
# Copy this file to .env and configure for your deployment.
# These variables are embedded at BUILD TIME by Vite.
# =============================================================

# -----------------------------------------------------------
# Production API URL
# -----------------------------------------------------------
# Set this to the full URL of your deployed backend API.
# Example: VITE_API_URL=https://api.bizguard.example.com/api/ai
#
# In development (npm run dev), leave this unset — the Vite
# dev proxy forwards /api requests to http://localhost:5000.
#
# VITE_API_URL=

# -----------------------------------------------------------
# Development API target (Vite proxy only)
# -----------------------------------------------------------
# The Vite dev server proxies /api requests to this URL.
# Only used during `npm run dev`. Ignored in production builds.
#
# VITE_API_TARGET=http://localhost:5000
